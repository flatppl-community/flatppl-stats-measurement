%%%
# Gaussian observation laws

$Y_i\sim N(\mu_i,\sigma_i^2)$ independently or
$Y\sim N(\mu,DRD)$, with $D=\operatorname{diag}(\sigma)$.
Calibration sets $\mu_i=a+g x_i$ and treats standards $x_i$ as exact.
%%%
flatppl_compat = "0.1"

% Independent measurements; sigma may be a scalar or match the mean vector.
independent_errors(means, sigma) = Normal.(means, sigma)

% Correlation is dimensionless; sigma contains marginal standard deviations.
correlated_errors(means, sigma, correlation) = MvNormal(
    means, correlation .* (addaxes(sigma, 0, 1) * addaxes(sigma, 1, 0))
)

% Affine response with independent Gaussian measurement error.
calibration(standards, offset, gain, sigma) = Normal.(offset .+ gain .* standards, sigma)
